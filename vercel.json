<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enactus Qena Evaluation System</title>
    <style>
        body { font-family: Arial, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 20px; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .card { background: #1e293b; padding: 30px; border-radius: 16px; width: 100%; max-width: 420px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); border: 1px solid #334155; }
        h2 { text-align: center; color: #fbbf24; margin-bottom: 5px; }
        p.sub { text-align: center; color: #94a3b8; font-size: 13px; margin-bottom: 20px; }
        label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: bold; color: #cbd5e1; }
        input, select, textarea { width: 100%; padding: 12px; margin-bottom: 15px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: #fff; box-sizing: border-box; font-size: 14px; }
        button { width: 100%; padding: 12px; background: #fbbf24; color: #0f172a; font-weight: bold; border: none; border-radius: 8px; cursor: pointer; font-size: 15px; transition: 0.2s; }
        button:hover { background: #f59e0b; }
        .tabs { display: flex; gap: 5px; margin-bottom: 20px; background: #0f172a; padding: 4px; border-radius: 8px; border: 1px solid #334155; }
        .tab-btn { flex: 1; padding: 10px; background: transparent; color: #94a3b8; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 13px; }
        .tab-btn.active { background: #fbbf24; color: #0f172a; }
        .btn-danger { background: #991b1b; color: #f87171; margin-top: 5px; }
        .btn-danger:hover { background: #7f1d1d; }
    </style>
</head>
<body>

    <div class="card" id="app">
        <!-- Dynamic Content -->
    </div>

    <script>
        // Database
        let db = JSON.parse(localStorage.getItem('enactus_final_db')) || {
            board: { name: "Board Admin", pass: "board123" },
            leaders: [
                { id: "l1", name: "Ahmed HR", committee: "PM", pass: "123" }
            ],
            members: [],
            evaluations: []
        };

        function saveDB() {
            localStorage.setItem('enactus_final_db', JSON.stringify(db));
        }

        let currentRole = 'leader'; // leader or board
        let currentUser = null;
        let currentView = 'login'; // login, dashboard

        function render() {
            const app = document.getElementById('app');

            if (currentView === 'login') {
                app.innerHTML = `
                    <h2>Enactus Qena</h2>
                    <p class="sub">Evaluation System</p>
                    
                    <div class="tabs">
                        <button class="tab-btn ${currentRole === 'leader' ? 'active' : ''}" onclick="setRole('leader')">HR Leader</button>
                        <button class="tab-btn ${currentRole === 'board'
